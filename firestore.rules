rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to validate post data
    function isValidPost() {
      let post = request.resource.data;
      return post.keys().hasAll(['title', 'content', 'imageURL', 'createdAt', 'slug', 'excerpt'])
             && post.title is string
             && post.content is string
             && post.imageURL is string;
    }

    // Connect to posts collection
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;
      
      // Only authenticated users can create/update/delete
      allow create: if isAuthenticated() && isValidPost();
      allow update: if isAuthenticated() && isValidPost();
      allow delete: if isAuthenticated();
    }
  }
}
